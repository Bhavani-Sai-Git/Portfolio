# Copy this file to `.env` and fill in what you need. All three are optional.
# (Values starting with VITE_ end up in the public JS bundle — never put secrets here.)

# Your live site address, no trailing slash. Used for the link-preview card
# on LinkedIn / WhatsApp / X, which needs a full URL to the image.
VITE_SITE_URL=https://your-domain.com

# Contact form: create a free form at https://formspree.io, then paste the ID
# from its endpoint (https://formspree.io/f/<THIS_PART>). Without it, the form
# opens the visitor's email app instead.
VITE_FORMSPREE_ID=

# Privacy-friendly analytics (https://plausible.io): the domain you registered there.
# Leave empty to load no analytics at all.
VITE_PLAUSIBLE_DOMAIN=
